    "# 1. Kategori dengan total pendapatan tertinggi\n",
    "print(\"--- 1. Kategori Pendapatan Tertinggi ---\")\n",
    "df_trans.groupBy(\"kategori\") \\\n",
    "    .agg(F.sum(\"total_pendapatan\").alias(\"total_pendapatan_kategori\")) \\\n",
    "    .orderBy(F.col(\"total_pendapatan_kategori\").desc()) \\\n",
    "    .show(1)\n",
    "\n",
    "# 2. Kota dengan jumlah transaksi tier 'Besar' terbanyak\n",
    "print(\"--- 2. Kota Transaksi Tier 'Besar' Terbanyak ---\")\n",
    "df_trans.filter(F.col(\"tier_transaksi\") == \"Besar\") \\\n",
    "    .groupBy(\"kota\") \\\n",
    "    .count() \\\n",
    "    .orderBy(F.col(\"count\").desc()) \\\n",
    "    .show(1)\n",
    "\n",
    "# 3. Rata-rata rating untuk masing-masing metode pembayaran\n",
    "print(\"--- 3. Rata-rata Rating per Metode Pembayaran ---\")\n",
    "df_trans.groupBy(\"metode_pembayaran\") \\\n",
